# ==============================================================================
# GCP Environment Variables & Secret Manager Configuration Template
# ==============================================================================

# GCP Project Settings
GCP_PROJECT_ID="sih-freight-forecast"
GCP_REGION="asia-south1"
GCP_REPOSITORY="freight-repo"
CLOUDSQL_INSTANCE="sih-freight-forecast:asia-south1:freight-db"

# Public Runtime Environment Variables (Configured on Cloud Run Services)
ENVIRONMENT="production"
LOG_LEVEL="info"
NEXT_PUBLIC_API_BASE_URL="https://freight-backend-xyz-el.a.run.app/api/v1"
BACKEND_CORS_ORIGINS="https://freight-frontend-xyz-el.a.run.app"

# Secret Manager Managed Secrets (Never committed to Git or baked into Docker images)
# 1. Secret Name: freight-db-url
#    Value: postgresql+psycopg2://freight_user:SECURE_PASSWORD@/freight_db?host=/cloudsql/sih-freight-forecast:asia-south1:freight-db
# 2. Secret Name: mapbox-token
#    Value: pk.eyJ1Ijo...
