# Copy to airflow/.env and set local development values. Never commit real credentials.

# Host user id so mounted logs stay writable (Linux): run `id -u`
AIRFLOW_UID=50000

# Airflow metadata database (separate from the application database)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow

# Local Airflow UI login
AIRFLOW_WWW_USER=airflow
AIRFLOW_WWW_PASSWORD=change-me
AIRFLOW_WEB_PORT=8080

# Application PostgreSQL database used by the ingestion services
APP_DB_USER=postgres
APP_DB_PASSWORD=change-me
APP_DB_NAME=freight
APP_DB_PORT=5432
APP_DATABASE_URL=postgresql+psycopg://postgres:change-me@app-db:5432/freight

# Synthetic dataset parameters
SYNTHETIC_INGESTION_SEED=42
SYNTHETIC_INGESTION_DAYS=180
